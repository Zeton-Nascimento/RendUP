{
  "name": "qa-cypress-rendup-sprint1",
  "version": "1.0.0",
  "private": true,
  "description": "Suítes Cypress independentes para as US da Sprint 1 do RendUP",
  "scripts": {
    "test:e2e": "cypress run --config-file cypress.config.cjs",
